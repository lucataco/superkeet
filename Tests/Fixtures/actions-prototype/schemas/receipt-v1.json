{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "manifest_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "probe_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "contract_sha256": {
      "type": "string",
      "pattern": "[0-9a-f]{64}"
    },
    "exit_code": {
      "enum": [
        0,
        1,
        2,
        3,
        4,
        130
      ]
    },
    "state": {
      "enum": [
        "PASS",
        "FAIL",
        "BLOCKED",
        "INCOMPLETE"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4096
    },
    "program_verified": {
      "const": false
    }
  },
  "required": [
    "schema_version",
    "run_id",
    "manifest_sha256",
    "probe_sha256",
    "contract_sha256",
    "exit_code",
    "state",
    "reason",
    "program_verified"
  ],
  "additionalProperties": false
}
